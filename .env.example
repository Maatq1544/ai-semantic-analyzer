# =============================================================================
# AI Semantic Analyzer — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# ---- LLM Provider ----
# Choose ONE provider. Uncomment the relevant section.

# DeepSeek (default — best price/performance)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local — fully offline)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---- Pipeline defaults (optional) ----
# Default batch size for parallel processing
SEMANTIC_BATCH_SIZE=10

# Max concurrent workers
SEMANTIC_MAX_WORKERS=5

# Chunk size in rows (0 = no chunking, process all at once)
SEMANTIC_CHUNK_SIZE=0

# Request timeout in seconds
SEMANTIC_TIMEOUT=60

# Max retries on transient failures
SEMANTIC_MAX_RETRIES=3

# Output format: csv | json | jsonl
SEMANTIC_OUTPUT_FORMAT=csv

# Log level: DEBUG | INFO | WARNING | ERROR
SEMANTIC_LOG_LEVEL=INFO
